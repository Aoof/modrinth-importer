{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modrinth Importer",
  "version": "0.1.0",
  "identifier": "com.aoof.modrinthimporter",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui install --frozen-lockfile && pnpm --dir ../ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Modrinth Importer",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 540,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.forgecdn.net; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Import mods and modpacks to Modrinth",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
